# Publish only Studio and its bundled Core components. Research and local data stay local.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/.github/
!/.github/**
!/docs/
!/docs/**
!/workspace/
/workspace/*
!/workspace/.gitignore
!/workspace/*.py
!/workspace/*.ps1
!/workspace/*.iss
!/workspace/*.spec
!/workspace/README.md
!/workspace/requirements*.txt
!/workspace/static/
!/workspace/static/**
!/workspace/assets/
!/workspace/assets/**
!/native-widgets/
/native-widgets/*
!/native-widgets/build.py
!/native-widgets/src/
!/native-widgets/src/**
!/native-widgets/compile-stubs/
!/native-widgets/compile-stubs/**
!/native-widgets/tests/
!/native-widgets/tests/**
!/core-notifications/
/core-notifications/*
!/core-notifications/AndroidManifest.xml
!/core-notifications/build.py
!/core-notifications/src/
!/core-notifications/src/**
!/core-notifications/res/
!/core-notifications/res/**
**/__pycache__/
*.pyc
*.log
*.jks
*.keystore
.env*
